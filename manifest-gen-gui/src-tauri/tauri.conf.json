{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eternum Manifest Generator",
  "version": "1.0.0",
  "identifier": "com.eternum.manifestgen",
  "build": {
    "frontendDist": "../src"
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Eternum — Генератор манифеста",
        "width": 860,
        "height": 820,
        "minWidth": 760,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
